{
  "name": "mock-builder",
  "description": "Build the mock from PR/FAQ",
  "mcpServers": {
    "AWS Core MCP Server": {
      "command": "uvx",
      "timeout": 60000,
      "args": [
        "awslabs.core-mcp-server@latest"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "AWS Documentation MCP Server": {
      "command": "uvx",
      "timeout": 60000,
      "args": [
        "awslabs.aws-documentation-mcp-server@latest"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "AWS_DOCUMENTATION_PARTITION": "aws"
      }
    },
    "aws-knowledge-mcp-server": {
      "command": "npx",
      "args": [
        "mcp-remote",
        "https://knowledge-mcp.global.api.aws"
      ]
    },
    "awslabs.nova-canvas-mcp-server": {
      "command": "uvx",
      "args": [
        "awslabs.nova-canvas-mcp-server@latest"
      ],
      "env": {
        "AWS_PROFILE": "default",
        "AWS_REGION": "us-east-1",
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": false,
      "autoApprove": []
    }
  },
  "tools": [
    "*"
  ],
  "allowedTools": [
    "fs_read",
    "fs_write",
    "execute_bash",
    "use_aws",
    "report_issue",
    "@AWS Core MCP Server/prompt_understanding",
    "@awslabs.nova-canvas-mcp-server/generate_image",
    "@awslabs.nova-canvas-mcp-server/generate_image_with_colors",
    "@AWS Documentation MCP Server/read_documentation",
    "@AWS Documentation MCP Server/recommend",
    "@AWS Documentation MCP Server/search_documentation",
    "@aws-knowledge-mcp-server/aws___read_documentation",
    "@aws-knowledge-mcp-server/aws___recommend",
    "@aws-knowledge-mcp-server/aws___search_documentation"
  ],
  "toolsSettings": {
    "execute_bash": {
      "alwaysAllow": [
        {
          "preset": "readOnly"
        }
      ]
    },
    "use_aws": {
      "alwaysAllow": [
        {
          "preset": "readOnly"
        }
      ]
    }
  },
  "resources": [
    "file://AGENTS.md",
    "file://prompt/prompt.md",
    "file://template/DEPLOYMENT_GUIDE.md",
    "file://template/TRACKER_INTEGRATION_GUIDE.md"
  ],
  "prompt": "あなたはワークショップ用のモックを作るソフトウェアエンジニアです。resources に読み込まれている prompt/prompt.md の目的・判断基準・完了条件に従って作業してください（読み直す必要はありません）。まず <application_requirements> と <tracker_configuration> の入力を集めます。依頼文に PR/FAQ や Tracker の値（またはその置き場所）が書かれていれば、それを使い、聞き直さないでください。PR/FAQ の指定が無ければ、まず discovery/README.md の Refine セクションを読み、そこが空のときだけユーザーに <application_requirements> の入力を促してください。<tracker_configuration> は必須ではありませんが、受け取った API Endpoint / API Key がプレースホルダーのままかどうかは prompt/prompt.md の <tracker_configuration> 直後の規則で判定し、当てはまれば着手せずユーザーに確認し、「Tracker を使わない」と明示されたときだけ Tracker なしで進めてください。最小の構成で、画面が動き Tracker の計測が届くことを最優先にしてください。prompt/prompt.md の完了条件を満たしたら、作り込みを続けずに止まって報告してください。"
}
