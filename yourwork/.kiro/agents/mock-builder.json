{
  "name": "mock-builder",
  "description": "Build the mock from PR/FAQ",
  "mcpServers": {
    "AWS Core MCP Server": {
      "command": "uvx",
      "timeout": 60000,
      "args": [
        "awslabs.core-mcp-server@latest"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "AWS Documentation MCP Server": {
      "command": "uvx",
      "timeout": 60000,
      "args": [
        "awslabs.aws-documentation-mcp-server@latest"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "AWS_DOCUMENTATION_PARTITION": "aws"
      }
    },
    "aws-knowledge-mcp-server": {
      "command": "npx",
      "args": [
          "mcp-remote",
          "https://knowledge-mcp.global.api.aws"
      ]
    },
    "awslabs.nova-canvas-mcp-server": {
      "command": "uvx",
      "args": ["awslabs.nova-canvas-mcp-server@latest"],
      "env": {
        "AWS_PROFILE": "default",
        "AWS_REGION": "us-east-1",
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": false,
      "autoApprove": []
    },
    "nx-plugin-for-aws": {
      "command": "npx",
      "args": ["-y", "@aws/nx-plugin-mcp"]
    }
  },
  "tools": [
	"*"
  ],
"allowedTools": [
    "fs_read",
    "fs_write", 
    "execute_bash",
    "use_aws",
    "report_issue",
    "@AWS Core MCP Server/prompt_understanding",
    "@awslabs.nova-canvas-mcp-server/generate_image",
    "@awslabs.nova-canvas-mcp-server/generate_image_with_colors",
    "@AWS Documentation MCP Server/read_documentation",
    "@AWS Documentation MCP Server/recommend", 
    "@AWS Documentation MCP Server/search_documentation",
    "@aws-knowledge-mcp-server/aws___read_documentation",
    "@aws-knowledge-mcp-server/aws___recommend",
    "@aws-knowledge-mcp-server/aws___search_documentation"
],
  "toolsSettings": {
    "execute_bash": {
      "alwaysAllow": [
        {
          "preset": "readOnly"
        }
      ]
    },
    "use_aws": {
      "alwaysAllow": [
        {
          "preset": "readOnly"
        }
      ]
    }
  },
  "resources": [
    "file://README.md",
    "file://AGENTS.md",
    "file://prompt/prompt.md",
    "file://template/DEPLOYMENT_GUIDE.md",
    "file://template/TRANCKER_INTEGRATION_GUIDE.md"
  ],
  "prompt":"あなたは経験豊富なソフトウェアエンジニアです。file://prompt/prompt.md を読み込み、指示通りに作業を行ってください。まず <application_requirements> と <tracker_configuration> の入力を集めます。依頼文に PR/FAQ や Tracker の値（またはその置き場所）が書かれていれば、それを使い、聞き直さないでください。PR/FAQ の指定が無ければ、まず discovery/README.md の Refine セクションを読み、そこが空のときだけユーザーに <application_requirements> の入力を促してください。<tracker_configuration> は必須ではありませんが、値がプレースホルダーのまま（{ を含む、xxxxxxxx や dummyapikey が残っている）なら着手せずユーザーに確認し、「Tracker を使わない」と明示されたときだけ Tracker なしで進めてください。入力が揃ったら file://prompt/prompt.md に基づいて作業を進めてください。遠慮せず、全力を尽くしてください。"
}